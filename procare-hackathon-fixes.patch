@@ -0,0 +1,82 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+/**
+ * Registers the PropCare NW service worker so the app is installable to a
+ * device home screen and resilient offline.
+ *
+ * Registration is skipped in development: the SW cache-firsts
+ * /_next/static assets, which would serve stale chunks while iterating.
+ * Run `npm run build && npm run start` (or deploy) to exercise install.
+ */
+export default function ServiceWorkerRegistrar() {
+  const [deferredPrompt, setDeferredPrompt] = useState<Event | null>(null);
+  const [dismissed, setDismissed] = useState(false);
+
+  useEffect(() => {
+    if (process.env.NODE_ENV === "development") return;
+    if (!("serviceWorker" in navigator)) return;
+
+    navigator.serviceWorker
+      .register("/sw.js", { scope: "/" })
+      .catch((err) => console.warn("[PropCare] SW registration failed", err));
+
+    const onBeforeInstall = (e: Event) => {
+      e.preventDefault();
+      setDeferredPrompt(e);
+    };
+    window.addEventListener("beforeinstallprompt", onBeforeInstall);
+    return () =>
+      window.removeEventListener("beforeinstallprompt", onBeforeInstall);
+  }, []);
+
+  const install = async () => {
+    if (!deferredPrompt) return;
+    // @ts-expect-error beforeinstallprompt is non-standard
+    deferredPrompt.prompt();
+    setDeferredPrompt(null);
+    setDismissed(true);
+  };
+
+  if (!deferredPrompt || dismissed) return null;
+
+  return (
+    <div
+      role="dialog"
+      aria-label="Install PropCare NW"
+      className="fixed bottom-4 left-4 right-4 z-[60] mx-auto flex max-w-md items-center gap-3 rounded-2xl border border-[#E6D5DC] bg-white p-3 shadow-card"
+    >
+      <img
+        src="/icons/icon-192.png"
+        alt=""
+        width={40}
+        height={40}
+        className="rounded-xl"
+      />
+      <div className="min-w-0 flex-1">
+        <div className="text-xs font-bold text-[#493344]">Install PropCare NW</div>
+        <div className="truncate text-[11px] text-[#806C7B]">
+          Add to your home screen for offline field access
+        </div>
+      </div>
+      <button
+        type="button"
+        onClick={install}
+        className="min-h-[40px] rounded-xl bg-[#79566F] px-3.5 text-xs font-semibold text-white hover:bg-[#67475E]"
+      >
+        Install
+      </button>
+      <button
+        type="button"
+        aria-label="Dismiss install prompt"
+        onClick={() => setDismissed(true)}
+        className="rounded-lg p-1.5 text-[#806C7B] hover:bg-[#F7EDE5] hover:text-[#493344]"
+      >
+        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
+          <path d="M18 6 6 18M6 6l12 12" />
+        </svg>
+      </button>
+    </div>
+  );
+}
