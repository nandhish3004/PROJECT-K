@@ -0,0 +1,70 @@
+import type { MetadataRoute } from "next";
+
+/**
+ * PropCare NW — Web App Manifest
+ * Makes the Next.js app installable to a device home screen (Android
+ * Chrome / iOS Safari "Add to Home Screen"), presenting it as a
+ * standalone app with its own icon, splash screen and window chrome.
+ */
+export default function manifest(): MetadataRoute.Manifest {
+  return {
+    name: "PropCare NW — Predictive Property Intelligence",
+    short_name: "PropCare NW",
+    description:
+      "AI-powered predictive property maintenance: non-destructive moisture scanning, cavity acoustic leak diagnostics, and Awaab's Law statutory compliance.",
+    id: "/",
+    start_url: "/app/dashboard",
+    scope: "/",
+    display: "standalone",
+    display_override: ["standalone", "minimal-ui"],
+    orientation: "any",
+    background_color: "#F7EDE5",
+    theme_color: "#79566F",
+    categories: ["business", "productivity", "utilities"],
+    lang: "en-GB",
+    dir: "ltr",
+    icons: [
+      {
+        src: "/icons/icon-192.png",
+        sizes: "192x192",
+        type: "image/png",
+        purpose: "any",
+      },
+      {
+        src: "/icons/icon-512.png",
+        sizes: "512x512",
+        type: "image/png",
+        purpose: "any",
+      },
+      {
+        src: "/icons/maskable-512.png",
+        sizes: "512x512",
+        type: "image/png",
+        purpose: "maskable",
+      },
+    ],
+    shortcuts: [
+      {
+        name: "Start Inspection",
+        short_name: "Inspect",
+        description: "Capture a new multi-modal field inspection",
+        url: "/app/inspections/new",
+        icons: [{ src: "/icons/icon-192.png", sizes: "192x192" }],
+      },
+      {
+        name: "Risk & Triage",
+        short_name: "Triage",
+        description: "Awaab's Law statutory SLA board",
+        url: "/app/risk-triage",
+        icons: [{ src: "/icons/icon-192.png", sizes: "192x192" }],
+      },
+      {
+        name: "Moisture AI (YOLO)",
+        short_name: "Moisture AI",
+        description: "Run YOLOv8 water-damage detection on a photo",
+        url: "/app/analysis/moisture",
+        icons: [{ src: "/icons/icon-192.png", sizes: "192x192" }],
+      },
+    ],
+  };
+}
